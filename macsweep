      review_d)  echo "pode ter dados teus: decide caso a caso" ;;
      total)     echo "Total" ;;
      inuse)     echo "em uso, fecha" ;;
      nothing)   echo "Nada encontrado acima de" ;;
      q_delete)  echo "Apagar?" ;;
      keys)      echo "[s]im  [n]ão  [t]odos os seguros  [r]esto não  [q]sair" ;;
      selected)  echo "Seleccionado" ;;
      none_sel)  echo "Nada seleccionado. Nada foi apagado." ;;
      confirm)   echo "Escreve APAGAR para confirmar (ou Enter para cancelar):" ;;
