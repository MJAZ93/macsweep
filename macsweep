      projects)  echo "Projectos" ;;
      inactive)  echo "inactivo há" ;;
      days)      echo "dias" ;;
      sudo_note) echo "pede password (sudo)" ;;
      hint_all)  echo "'t' selecciona todos os SEGUROS de uma vez; os VERIFICAR são sempre um a um." ;;
      log)       echo "Registo em" ;;
      no_tty)    echo "Sem terminal interactivo; a correr só análise." ;;
      no_python) echo "A interface precisa de python3 (vem com as Command Line Tools). Instala com: xcode-select --install" ;;
