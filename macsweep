      days)      echo "days" ;;
      sudo_note) echo "asks for password (sudo)" ;;
      hint_all)  echo "'a' selects every SAFE item at once; REVIEW items are always one by one." ;;
      log)       echo "Log at" ;;
      no_tty)    echo "No interactive terminal; running scan only." ;;
      no_python) echo "The UI needs python3 (it ships with the Command Line Tools). Install with: xcode-select --install" ;;
    esac
  fi
}
YES_KEY="y"; ALL_KEY="a"; [ "$LANG_UI" = "pt" ] && { YES_KEY="s"; ALL_KEY="t"; }

# ── colours ───────────────────────────────────────────────────────────────────
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  B=$'\033[1m'; D=$'\033[2m'; R=$'\033[0m'
  GRN=$'\033[32m'; YEL=$'\033[33m'; RED=$'\033[31m'; CYN=$'\033[36m'; MAG=$'\033[35m'; WHT=$'\033[97m'
  BG_GRN=$'\033[42;30m'; BG_YEL=$'\033[43;30m'; BG_RED=$'\033[41;97m'; BG_BLU=$'\033[44;97m'
else
  B=""; D=""; R=""; GRN=""; YEL=""; RED=""; CYN=""; MAG=""; WHT=""; BG_GRN=""; BG_YEL=""; BG_RED=""; BG_BLU=""
fi
COLS=$(tput cols 2>/dev/null || echo 80); [ "$COLS" -gt 100 ] && COLS=100

# ── ui helpers ────────────────────────────────────────────────────────────────
line()   { printf '%s' "$D"; printf '─%.0s' $(seq 1 "$COLS"); printf '%s\n' "$R"; }
hdr()    { echo; printf '%s%s %s %s\n' "$B" "$CYN" "$1" "$R"; line; }
human()  { awk -v k="${1:-0}" 'BEGIN{ if (k>=1048576) printf "%5.1f GB", k/1048576; else if (k>=1024) printf "%5.0f MB", k/1024; else printf "%5.0f KB", k }'; }
badge()  { case "$1" in
             SAFE)    printf '%s %-11s %s' "$BG_GRN" "$(t safe)" "$R" ;;
             REBUILD) printf '%s %-11s %s' "$BG_YEL" "$(t rebuild)" "$R" ;;
             REVIEW)  printf '%s %-11s %s' "$BG_RED" "$(t review)" "$R" ;;
           esac; }
spin_pid=""
spin_start() { [ -t 1 ] || return 0
  ( i=0; f='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
    while :; do printf '\r%s%s%s %s %s…  ' "$CYN" "${f:$((i%10)):1}" "$R" "$(t scanning)" "$1"; i=$((i+1)); sleep 0.08; done ) &
  spin_pid=$!; }
spin_stop()  { [ -n "$spin_pid" ] && { kill "$spin_pid" 2>/dev/null; wait "$spin_pid" 2>/dev/null; spin_pid=""; printf '\r%*s\r' "$COLS" ""; }; }
trap 'spin_stop; echo; exit 130' INT TERM

banner() {
  echo
  printf '%s%s' "$B" "$MAG"
  cat <<'EOF'
   ███╗   ███╗ █████╗  ██████╗███████╗██╗    ██╗███████╗███████╗██████╗
   ████╗ ████║██╔══██╗██╔════╝██╔════╝██║    ██║██╔════╝██╔════╝██╔══██╗
   ██╔████╔██║███████║██║     ███████╗██║ █╗ ██║█████╗  █████╗  ██████╔╝
   ██║╚██╔╝██║██╔══██║██║     ╚════██║██║███╗██║██╔══╝  ██╔══╝  ██╔═══╝
   ██║ ╚═╝ ██║██║  ██║╚██████╗███████║╚███╔███╔╝███████╗███████╗██║
   ╚═╝     ╚═╝╚═╝  ╚═╝ ╚═════╝╚══════╝ ╚══╝╚══╝ ╚══════╝╚══════╝╚═╝
EOF
  printf '%s   %sv%s · %s%s\n\n' "$R" "$D" "$VERSION" "$(t tagline)" "$R"
}

disk_free_k() { df -k / | awk 'NR==2{print $4}'; }
disk_line() {
  df -k / | awk -v f="$(t free)" -v o="$(t of)" -v u="$(t used)" -v B="$B" -v R="$R" -v G="$GRN" -v Y="$YEL" -v Rd="$RED" 'NR==2{
    tot=$2/1048576; avail=$4/1048576; pct=100-($4*100/$2);
    col=(pct>90)?Rd:(pct>75)?Y:G;
    bar=""; n=int(pct/2.5); for(i=0;i<40;i++) bar=bar ((i<n)?"█":"░");
    printf "  %s%s%s%s  %s%5.1f GB%s %s %s %s%.0f GB%s  (%.0f%% %s)\n", B, col, bar, R, B, avail, R, f, o, B, tot, R, pct, u }'
}

# ── running apps ──────────────────────────────────────────────────────────────
running() { pgrep -f "$1" >/dev/null 2>&1; }
XCODE_UP=0; running "Xcode.app/Contents/MacOS/Xcode" && XCODE_UP=1
SIM_UP=0;   running "Simulator.app/Contents/MacOS/Simulator" && SIM_UP=1
AS_UP=0;    running "Android Studio.app/Contents/MacOS" && AS_UP=1
EMU_UP=0;   running "qemu-system" && EMU_UP=1
GRADLE_UP=0; running "GradleDaemon|KotlinCompileDaemon" && GRADLE_UP=1
JB_UP=0;    running "GoLand|WebStorm|RustRover|DataGrip|PyCharm|IntelliJ|CLion|PhpStorm|Rider|RubyMine" && JB_UP=1
CHROME_UP=0; pgrep -x "Google Chrome" >/dev/null 2>&1 && CHROME_UP=1
DOCKER_UP=0; docker info >/dev/null 2>&1 && DOCKER_UP=1

# ── item catalog (parallel arrays: bash 3.2 has no associative arrays) ────────
N=0
I_TIER=(); I_LABEL=(); I_PATHS=(); I_NOTE=(); I_SIZE=(); I_HANDLER=(); I_BLOCK=(); I_SEL=()
# add TIER "label" "note" "blocker-or-empty" "handler-or-rm" path...
add() {
  local tier="$1" label="$2" note="$3" block="$4" handler="$5"; shift 5
  local paths="" p k=0 exists=0
  for p in "$@"; do
    [ -e "$p" ] || continue
    exists=1; paths="${paths}${p}"$'\n'
  done
  [ "$exists" -eq 0 ] && return 0
  k=$(printf '%s' "$paths" | tr '\n' '\0' | xargs -0 du -skc 2>/dev/null | tail -1 | cut -f1)
  k=${k:-0}
  [ "$k" -lt $((MIN_MB*1024)) ] && return 0
  I_TIER[$N]="$tier"; I_LABEL[$N]="$label"; I_PATHS[$N]="$paths"; I_NOTE[$N]="$note"
  I_SIZE[$N]="$k"; I_HANDLER[$N]="$handler"; I_BLOCK[$N]="$block"; I_SEL[$N]=0
  N=$((N+1))
}

# ── custom handlers (called at delete time) ───────────────────────────────────
h_rm()             { printf '%s' "$1" | tr '\n' '\0' | xargs -0 rm -rf; }
h_brew()           { brew cleanup --prune=all >/dev/null 2>&1; h_rm "$1"; }
h_sim_unavail()    { xcrun simctl delete unavailable >/dev/null 2>&1; }
h_sim_runtime()    { xcrun simctl shutdown all >/dev/null 2>&1; xcrun simctl runtime delete "$2" >/dev/null 2>&1; sleep 3; xcrun simctl delete unavailable >/dev/null 2>&1; }
h_sudo_rm()        { if [ $UI_EXEC -eq 1 ]; then   # no terminal: ask for the password with the native macOS dialog
                       printf '%s' "$1" | while IFS= read -r p; do [ -n "$p" ] && osascript -e 'on run argv' \
                         -e 'do shell script "rm -rf " & quoted form of (item 1 of argv) with administrator privileges' -e 'end run' "$p" </dev/null; done
                       return 0; fi
                     echo; echo "  $(t sudo_note)"; printf '%s' "$1" | tr '\n' '\0' | sudo xargs -0 rm -rf 2>/dev/null; true; }
h_docker_prune()   { docker system prune -a -f >/dev/null 2>&1; }
h_worktree()       { local d repo; d=$(printf '%s' "$1" | head -1); repo="$2"
                     git -C "$repo" worktree remove --force "$d" >/dev/null 2>&1 || rm -rf "$d"; git -C "$repo" worktree prune >/dev/null 2>&1; }
h_trash()          { osascript -e 'tell application "Finder" to empty trash' >/dev/null 2>&1; }

log_start()  { mkdir -p "$(dirname "$LOG_FILE")"; echo "== $(date '+%Y-%m-%d %H:%M') macsweep $VERSION${1:-}" >> "$LOG_FILE"; }
delete_item() {  # runs the handler of item $1 and logs it
  local i="$1" h="${I_HANDLER[$1]}" arg=""
  case "$h" in *" "*) arg="${h#* }"; h="${h%% *}" ;; esac
  case "$h" in rm|brew|sim_unavail|sim_runtime|sudo_rm|docker_prune|worktree|trash) ;; *) return 1 ;; esac
  "h_$h" "${I_PATHS[$i]}" "$arg"
  printf '%s\t%s\n' "${I_LABEL[$i]}" "$(printf '%s' "${I_PATHS[$i]}" | tr '\n' ' ')" >> "$LOG_FILE"
}

# ── scan ──────────────────────────────────────────────────────────────────────
scan() {
  local L="$HOME/Library" C="$HOME/Library/Caches" blk
  spin_start "Xcode"
  # Xcode DeviceSupport: keep newest of each device model
  local ds="$L/Developer/Xcode/iOS DeviceSupport"
  if [ -d "$ds" ]; then
    local old=() d
    while IFS= read -r d; do old[${#old[@]}]="$ds/$d"; done < <(
      ls "$ds" 2>/dev/null | awk '{ split($2,v,"."); printf "%s\t%05d.%05d.%05d\t%s\n", $1, v[1], v[2], v[3], $0 }' \
        | sort -t$'\t' -k1,1 -k2,2 | awk -F'\t' '{ if (prev==$1) print last; prev=$1; last=$3 }')
    [ ${#old[@]} -gt 0 ] && add SAFE "Xcode iOS DeviceSupport (old versions)" "symbols for iOS versions your iPhone no longer runs; newest kept" "" rm "${old[@]}"
  fi
  blk=""; [ $XCODE_UP -eq 1 ] && blk="Xcode"
  add SAFE "Xcode DerivedData" "intermediate builds; next build is slower once" "$blk" rm "$L/Developer/Xcode/DerivedData"
  add SAFE "Xcode Archives" "exported .xcarchive bundles (keep if you need to re-symbolicate old releases)" "" rm "$L/Developer/Xcode/Archives"
  add SAFE "CoreSimulator caches (user)" "" "" rm "$L/Developer/CoreSimulator/Caches"
  add SAFE "CoreSimulator dyld cache (system)" "$(t sudo_note); entries of the active runtime are protected and are skipped" "" sudo_rm "/Library/Developer/CoreSimulator/Caches/dyld"
  add SAFE "Swift Package Manager cache" "" "" rm "$C/org.swift.swiftpm"
  add SAFE "CocoaPods cache" "" "" rm "$C/CocoaPods"
  # unavailable simulators
  local unav; unav=$(xcrun simctl list devices unavailable 2>/dev/null | grep -c unavailable); unav=${unav:-0}
  if [ "${unav:-0}" -gt 0 ]; then
    I_TIER[$N]="SAFE"; I_LABEL[$N]="Unavailable simulators ($unav)"; I_PATHS[$N]=""; I_NOTE[$N]="devices whose runtime is gone"; I_SIZE[$N]=0; I_HANDLER[$N]="sim_unavail"; I_BLOCK[$N]=""; I_SEL[$N]=0; N=$((N+1))
  fi
  # simulator runtimes (REVIEW, one per runtime)
  blk=""; [ $SIM_UP -eq 1 ] && blk="Simulator"
  while IFS= read -r rl; do
    [ -n "$rl" ] || continue
    local rname rbuild rid vol
    rname=$(echo "$rl" | sed -E 's/ \(.*//'); rbuild=$(echo "$rl" | sed -E 's/^[^(]*\(([^)]+)\).*/\1/'); rid=$(echo "$rl" | sed -E 's/.* - ([A-F0-9-]+) .*/\1/')
    vol="/Library/Developer/CoreSimulator/Volumes/$(echo "$rname" | cut -d' ' -f1)_$rbuild"
    [ -d "$vol" ] || continue
    add REVIEW "Simulator runtime $rname" "all simulators on this runtime become unusable; re-download in Xcode > Settings > Components" "$blk" "sim_runtime $rid" "$vol"
  done < <(xcrun simctl runtime list 2>/dev/null | grep -E "^(iOS|watchOS|tvOS|visionOS) " )
  spin_stop

  spin_start "Android"
  blk=""; [ $EMU_UP -eq 1 ] && blk="Emulator"
  for d in "$HOME"/.android/avd/*.avd; do
    [ -d "$d" ] || continue
    local an; an=$(basename "$d" .avd)
    add SAFE "AVD $an: snapshots" "quick-boot state only; the emulator cold-boots once" "$blk" rm "$d/snapshots"
    add REVIEW "AVD $an: wipe data" "factory reset: removes installed apps and data, keeps the device" "$blk" rm \
        "$d/userdata-qemu.img" "$d/userdata-qemu.img.qcow2" "$d/cache.img" "$d/cache.img.qcow2" "$d/sdcard.img.qcow2" \
        "$d/encryptionkey.img" "$d/encryptionkey.img.qcow2" "$d/tmpAdbCmds"
  done
  local SDK="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-$HOME/Library/Android/sdk}}"
  if [ -d "$SDK/ndk" ]; then
    local nd
    for nd in "$SDK"/ndk/*/; do [ -d "$nd" ] && add REVIEW "Android NDK $(basename "$nd")" "only needed for native (C/C++) builds; re-download in SDK Manager" "" rm "$nd"; done
  fi
  if [ -d "$SDK/system-images" ]; then
    local si
    for si in "$SDK"/system-images/*/*/*/; do [ -d "$si" ] && add REVIEW "Android system image $(echo "$si" | awk -F/ '{print $(NF-3)"/"$(NF-2)"/"$(NF-1)}')" "needed by AVDs of that API level; re-download in SDK Manager" "" rm "$si"; done
  fi
  blk=""; [ $AS_UP -eq 1 ] && blk="Android Studio"; [ $GRADLE_UP -eq 1 ] && blk="Gradle daemon"
  add SAFE "Gradle caches" "dependencies and build cache; re-downloaded on next build" "$blk" rm "$HOME/.gradle/caches" "$HOME/.gradle/daemon"
  add SAFE "Gradle distributions" "downloaded Gradle versions" "$blk" rm "$HOME/.gradle/wrapper/dists"
  add SAFE "Android Studio caches + logs" "" "$blk" rm "$C"/Google/AndroidStudio* "$L"/Logs/Google/AndroidStudio*
  add SAFE "Android emulator cache" "" "" rm "$HOME/.android/cache"
  spin_stop

  spin_start "IDEs & tools"
  blk=""; [ $JB_UP -eq 1 ] && blk="JetBrains IDE"
  add SAFE "JetBrains caches + logs" "indexes and logs for every JetBrains IDE; rebuilt on next open" "$blk" rm "$C/JetBrains" "$L/Logs/JetBrains"
  add SAFE "npm cache" "" "" rm "$HOME/.npm/_cacache" "$HOME/.npm/_logs" "$HOME/.npm/_npx"
  add SAFE "pnpm store + cache" "" "" rm "$L/pnpm/store" "$C/pnpm"
  add SAFE "Yarn cache" "" "" rm "$C/Yarn" "$HOME/.yarn/berry/cache"
  add SAFE "Bun cache" "" "" rm "$HOME/.bun/install/cache"
  add SAFE "Go build cache" "" "" rm "$C/go-build"
  add REBUILD "Go module cache (~/go/pkg/mod)" "re-downloaded with 'go mod download'" "" rm "$HOME/go/pkg/mod"
  add SAFE "pip / uv caches" "" "" rm "$C/pip" "$HOME/.cache/uv" "$HOME/.cache/pip"
  add SAFE "Cargo registry cache" "" "" rm "$HOME/.cargo/registry/cache" "$HOME/.cargo/registry/src"
  add SAFE "Maven repository (~/.m2)" "" "" rm "$HOME/.m2/repository"
  add SAFE "Dart / Flutter pub cache" "" "" rm "$HOME/.pub-cache"
  add SAFE "Puppeteer / Playwright browsers" "" "" rm "$HOME/.cache/puppeteer" "$C/ms-playwright" "$C/ms-playwright-go"
  add SAFE "Homebrew cache + old versions" "runs 'brew cleanup --prune=all'" "" brew "$C/Homebrew"
  add SAFE "Zig / node-gyp / Apple python caches" "" "" rm "$HOME/.cache/zig" "$C/node-gyp" "$C/com.apple.python"
  add SAFE "Codex cache" "" "" rm "$C/com.openai.codex"
  add SAFE "Claude Desktop caches" "" "" rm "$L/Application Support/Claude/Cache" "$L/Application Support/Claude/Code Cache"
  blk=""; [ $CHROME_UP -eq 1 ] && blk="Chrome"
  add SAFE "Chrome cache" "" "$blk" rm "$C/Google/Chrome" "$C/Google/Chrome-headless"
  add SAFE "App updaters (ShipIt / Squirrel leftovers)" "staged updates for Electron apps" "" rm "$C"/*.ShipIt/update.* "$C"/*-updater
  add SAFE "Dynamic wallpaper cache" "" "" rm "$L/Application Support/com.apple.wallpaper/aerials"
  spin_stop

  spin_start "Docker"
  local dvm="$L/Containers/com.docker.docker/Data/vms"
  if [ -d "$dvm" ]; then
    if [ $DOCKER_UP -eq 1 ]; then
      add REVIEW "Docker: prune unused images, containers, build cache" "runs 'docker system prune -a' (volumes are kept). VM file shrinks only if 'Disk image size' is reduced in Docker Desktop" "" docker_prune "$dvm"
    else
      I_TIER[$N]="REVIEW"; I_LABEL[$N]="Docker VM"; I_PATHS[$N]=""; I_NOTE[$N]="images, containers and build cache live inside this file"; I_SIZE[$N]=$(du -sk "$dvm" 2>/dev/null | cut -f1); I_HANDLER[$N]="none"; I_BLOCK[$N]="!Docker Desktop is not running: start it and rerun to prune"; I_SEL[$N]=0; N=$((N+1))
    fi
  fi
  spin_stop

  if [ $FAST -eq 0 ] && [ -n "$PROJECTS_DIR" ] && [ -d "$PROJECTS_DIR" ]; then
    spin_start "$(t projects)"
    local p last now age arts
    now=$(date +%s)
    for p in "$PROJECTS_DIR"/*/; do
      p=${p%/}; [ -d "$p" ] || continue
      # last real activity: newest file outside artifacts/noise
      last=$(find "$p" -type f -not -path "*/node_modules/*" -not -path "*/.git/*" -not -path "*/build/*" -not -path "*/.gradle/*" \
             -not -path "*/Pods/*" -not -path "*/.venv/*" -not -path "*/dist/*" -not -path "*/.claude/*" -not -path "*/.idea/*" \
             -not -name .DS_Store -not -name "*.lock" -exec stat -f '%m' {} + 2>/dev/null | sort -n | tail -1)
      [ -n "$last" ] || continue
      age=$(( (now - last) / 86400 ))
      arts=()
      while IFS= read -r d; do arts[${#arts[@]}]="$d"; done < <(find "$p" \( -name node_modules -o -name build -o -name Pods -o -name .venv -o -name venv -o -name .gradle -o -name .build -o -name target -o -name .dart_tool -o -name .next \) -type d -prune 2>/dev/null)
      [ ${#arts[@]} -gt 0 ] || continue
      if [ "$age" -ge "$INACTIVE_DAYS" ]; then
        add REBUILD "$(basename "$p"): build artifacts ($(t inactive) $age $(t days))" "node_modules, build, Pods, .venv… reinstall when you return" "" rm "${arts[@]}"
      fi
      # Claude Code / git worktrees
      if [ -d "$p/.claude/worktrees" ]; then
        local w
        for w in "$p"/.claude/worktrees/*/; do
          w=${w%/}; [ -d "$w" ] || continue
          local dirty; dirty=$(git -C "$w" status --porcelain 2>/dev/null | head -1)
          [ -n "$dirty" ] && continue   # never offer a worktree with uncommitted changes
          add REVIEW "$(basename "$p"): worktree $(basename "$w")" "clean worktree; its branch stays in the repo" "" "worktree $p" "$w"
        done
      fi
    done
    spin_stop
  fi

  local tk; tk=$(du -sk "$HOME/.Trash" 2>/dev/null | cut -f1); tk=${tk:-0}
  if [ "$tk" -ge $((MIN_MB*1024)) ]; then
    I_TIER[$N]="REVIEW"; I_LABEL[$N]="Empty Trash"; I_PATHS[$N]=""; I_NOTE[$N]="via Finder"; I_SIZE[$N]=$tk; I_HANDLER[$N]="trash"; I_BLOCK[$N]=""; I_SEL[$N]=0; N=$((N+1))
  fi
}

# ── report ────────────────────────────────────────────────────────────────────
sorted_idx() { # prints indexes of a tier, largest first
  local i; for ((i=0;i<N;i++)); do [ "${I_TIER[$i]}" = "$1" ] && printf '%s\t%s\n' "${I_SIZE[$i]}" "$i"; done | sort -rn | cut -f2
}
tier_total() { local i s=0; for ((i=0;i<N;i++)); do [ "${I_TIER[$i]}" = "$1" ] && s=$((s + I_SIZE[i])); done; echo "$s"; }
print_item() {
  local i="$1" num="$2" mark="$3"
  printf '  %s%3s%s %s %s%s%s  %s\n' "$D" "$num" "$R" "$mark" "$B" "$(human "${I_SIZE[$i]}")" "$R" "${I_LABEL[$i]}"
  [ -n "${I_NOTE[$i]}" ] && printf '          %s%s%s\n' "$D" "${I_NOTE[$i]}" "$R"
  if [ -n "${I_BLOCK[$i]}" ]; then
    case "${I_BLOCK[$i]}" in
      !*) printf '          %s⚠ %s%s\n' "$YEL" "${I_BLOCK[$i]#!}" "$R" ;;
      *)  printf '          %s⚠ %s %s%s\n' "$YEL" "$(t inuse)" "${I_BLOCK[$i]}" "$R" ;;
    esac
  fi
}
report() {
  local tier i n=0
  for tier in SAFE REBUILD REVIEW; do
    local tot; tot=$(tier_total "$tier")
    echo; printf '  %s  %s%s%s   %s%s%s\n' "$(badge "$tier")" "$B" "$(human "$tot")" "$R" "$D" "$(t "$(echo "$tier" | tr 'A-Z' 'a-z')_d")" "$R"; line
    local any=0
    for i in $(sorted_idx "$tier"); do n=$((n+1)); any=1; print_item "$i" "$n" " "; done
    [ $any -eq 0 ] && printf '  %s%s %s MB%s\n' "$D" "$(t nothing)" "$MIN_MB" "$R"
  done
}

# ── interactive selection ─────────────────────────────────────────────────────
ask() {  # returns 0=yes 1=no 2=all-safe 3=rest-no 4=quit
  local k
  while :; do
    printf '      %s%s%s %s%s%s ' "$B" "$(t q_delete)" "$R" "$D" "$(t keys)" "$R"
    read -r -n1 k </dev/tty; echo
    case "$k" in
      "$YES_KEY"|Y|y|s|S) return 0 ;; n|N|"") return 1 ;; "$ALL_KEY"|a|A|t|T) return 2 ;; r|R) return 3 ;; q|Q) return 4 ;;
    esac
  done
}
select_items() {
  local tier i n=0 rc all_safe=0 rest_no=0
  echo; printf '  %s%s%s\n' "$D" "$(t hint_all)" "$R"
  for tier in SAFE REBUILD REVIEW; do
    echo; printf '  %s\n' "$(badge "$tier")"; line
    for i in $(sorted_idx "$tier"); do
      n=$((n+1))
      if [ -n "${I_BLOCK[$i]}" ] || [ "${I_HANDLER[$i]}" = "none" ]; then print_item "$i" "$n" "$D·$R"; continue; fi
      if [ $rest_no -eq 1 ]; then print_item "$i" "$n" "$D·$R"; continue; fi
      if [ "$tier" = "SAFE" ] && { [ $all_safe -eq 1 ] || [ $AUTO_YES -eq 1 ]; }; then I_SEL[$i]=1; print_item "$i" "$n" "$GRN✔$R"; continue; fi
      print_item "$i" "$n" " "
      while :; do
        ask; rc=$?
        [ $rc -eq 2 ] && [ "$tier" != "SAFE" ] && { printf '      %s%s%s\n' "$YEL" "$(t hint_all)" "$R"; continue; }
        break
      done
      case $rc in
        0) I_SEL[$i]=1 ;;
        2) all_safe=1; I_SEL[$i]=1 ;;
        3) rest_no=1 ;;
        4) echo; echo "  $(t cancelled)"; exit 0 ;;
      esac
    done
  done
}

# ── execute ───────────────────────────────────────────────────────────────────
execute() {
  local i sel=0 tot=0
  hdr "$(t selected)"
  local tier
  for tier in SAFE REBUILD REVIEW; do for i in $(sorted_idx "$tier"); do
    [ "${I_SEL[$i]}" = "1" ] || continue
    sel=$((sel+1)); tot=$((tot + I_SIZE[i]))
    printf '  %s✔%s %s %s%s%s  %s\n' "$GRN" "$R" "$(badge "$tier")" "$B" "$(human "${I_SIZE[$i]}")" "$R" "${I_LABEL[$i]}"
  done; done
  if [ $sel -eq 0 ]; then echo "  $(t none_sel)"; return 0; fi
  line; printf '  %s%s: %s%s\n' "$B" "$(t total)" "$(human "$tot")" "$R"
  [ $DRY_RUN -eq 1 ] && { echo; printf '  %s%s%s\n' "$YEL" "$(t dry)" "$R"; return 0; }
  echo; printf '  %s ' "$(t confirm)"; local ans; read -r ans </dev/tty
  [ "$ans" = "$(t confirm_w)" ] || { echo "  $(t cancelled)"; return 0; }

  local before after; before=$(disk_free_k)
  log_start
  hdr "$(t deleting)"
  for ((i=0;i<N;i++)); do
    [ "${I_SEL[$i]}" = "1" ] || continue
    printf '  %s…%s %s' "$CYN" "$R" "${I_LABEL[$i]}"
    delete_item "$i"
    printf '\r  %s✔%s %s\n' "$GRN" "$R" "${I_LABEL[$i]}"
  done
  after=$(disk_free_k)
  echo; line
  printf '  %s%s%s  %s%s %s%s\n' "$B" "$(t done)." "$R" "$GRN$B" "$(human $((after - before)))" "$(t freed)" "$R"
  disk_line
  printf '  %s%s %s%s\n' "$D" "$(t log)" "$LOG_FILE" "$R"
}

# ── ui (macsweep ui) ──────────────────────────────────────────────────────────
# The browser UI is a page served by a small python3 server bound to 127.0.0.1.
# Bash still owns everything that matters: the scan, the catalog and the
# handlers. The server only re-invokes this script (__scan / __exec) and passes
# the results on. Every API call needs a random token that only the opened tab
# knows, and the delete call needs the confirmation word, like the terminal.
ui_dump() {  # writes the catalog NUL-separated: 10 header fields, then 7 per item
  local f="$1" i
  {
    printf '%s\0' "macsweep-ui-1" "$VERSION" "$LANG_UI" "$(df -k / | awk 'NR==2{print $2}')" "$(disk_free_k)" \
                  "$PROJECTS_DIR" "$DRY_RUN" "$MIN_MB" "$LOG_FILE" "$N"
    for ((i=0;i<N;i++)); do
      printf '%s\0' "${I_TIER[$i]}" "${I_LABEL[$i]}" "${I_NOTE[$i]}" "${I_BLOCK[$i]}" "${I_HANDLER[$i]}" "${I_SIZE[$i]:-0}" "${I_PATHS[$i]}"
    done
  } > "$f.tmp" && mv "$f.tmp" "$f"
}
ui_load() {
  local x i b f=()
  while IFS= read -r -d '' x; do f[${#f[@]}]="$x"; done < "$1"
  [ "${f[0]:-}" = "macsweep-ui-1" ] || return 1
  N=${f[9]}
  for ((i=0;i<N;i++)); do
    b=$((10 + i*7))
    I_TIER[$i]="${f[$b]}"; I_LABEL[$i]="${f[$((b+1))]}"; I_NOTE[$i]="${f[$((b+2))]}"; I_BLOCK[$i]="${f[$((b+3))]}"
    I_HANDLER[$i]="${f[$((b+4))]}"; I_SIZE[$i]="${f[$((b+5))]}"; I_PATHS[$i]="${f[$((b+6))]}"; I_SEL[$i]=0
  done
}
ui_exec() {  # $1 = comma-separated item ids; prints S/D/F lines for the server
  local id before after
  before=$(disk_free_k)
  [ $DRY_RUN -eq 1 ] || log_start " (ui)"
  for id in $(printf '%s' "$1" | tr ',' ' '); do
    case "$id" in ''|*[!0-9]*) continue ;; esac
    [ "$id" -lt "$N" ] || continue
    { [ -z "${I_BLOCK[$id]}" ] && [ "${I_HANDLER[$id]}" != "none" ]; } || continue
    printf 'S\t%s\n' "$id"
    if [ $DRY_RUN -eq 1 ]; then sleep 0.3; else delete_item "$id" >/dev/null 2>&1; fi
    printf 'D\t%s\n' "$id"
  done
  after=$(disk_free_k)
  printf 'F\t%s\t%s\n' "$((after - before))" "$after"
}
ui_python() {
  local py; py=$(command -v python3 2>/dev/null)
  # /usr/bin/python3 is only a stub until the Command Line Tools are installed
  if [ -z "$py" ] || { [ "$py" = "/usr/bin/python3" ] && [ "$(uname)" = "Darwin" ] && ! xcode-select -p >/dev/null 2>&1; }; then
    printf '%s\n' "$(t no_python)" >&2; return 1
  fi
  printf '%s\n' "$py"
}
ui_main() {
  local py self fwd
  py=$(ui_python) || return 1
  case "$0" in /*) self="$0" ;; *) self="$PWD/$0" ;; esac
  UI_DIR=$(mktemp -d "${TMPDIR:-/tmp}/macsweep-ui.XXXXXX") || return 1
  trap 'rm -rf "$UI_DIR"' EXIT
  ui_server_py > "$UI_DIR/server.py"; ui_page > "$UI_DIR/index.html"
  fwd=(--days "$INACTIVE_DAYS" --min-mb "$MIN_MB" --lang "$LANG_UI")
  [ -n "$PROJECTS_DIR" ] && fwd=("${fwd[@]}" --projects "$PROJECTS_DIR")
  [ $FAST -eq 1 ] && fwd=("${fwd[@]}" --fast)
  [ $DRY_RUN -eq 1 ] && fwd=("${fwd[@]}" --dry-run)
  banner
  disk_line
  scan
  ui_dump "$UI_DIR/scan.dat"
  [ $NO_OPEN -eq 1 ] && export MACSWEEP_NO_OPEN=1
  "$py" "$UI_DIR/server.py" "$UI_DIR" "$self" "${fwd[@]}"
}
ui_server_py() { cat <<'PY'
import json, os, secrets, shutil, subprocess, sys, threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

UI_DIR, SELF, OPTS = sys.argv[1], sys.argv[2], sys.argv[3:]
DUMP = os.path.join(UI_DIR, "scan.dat")
TOKEN = secrets.token_urlsafe(24)
BUSY = threading.Lock()
CONFIRM = {"en": "DELETE", "pt": "APAGAR"}
MSG = {
    "en": ("macsweep is open in your browser:", "Leave this terminal open. Ctrl+C (or Quit in the page) stops it.", "stopped."),
    "pt": ("O macsweep está aberto no browser:", "Deixa este terminal aberto. Ctrl+C (ou Sair na página) termina.", "terminado."),
}


def num(s):
    try:
        return int(s)
    except ValueError:
        return 0


def load_state():
    with open(DUMP, "rb") as fh:
        f = fh.read().decode("utf-8", "replace").split("\0")
    if f[0] != "macsweep-ui-1":
        raise ValueError("unexpected scan file")
    st = {"version": f[1], "lang": f[2], "disk": {"total_k": num(f[3]), "free_k": num(f[4])},
          "projects": f[5], "dry_run": f[6] == "1", "min_mb": num(f[7]), "log": f[8], "items": []}
    for i in range(num(f[9])):
        tier, label, note, block, handler, size, paths = f[10 + i * 7:17 + i * 7]
        st["items"].append({
            "id": i, "tier": tier, "label": label, "note": note,
            "block": block[1:] if block.startswith("!") else block,
            "block_msg": block.startswith("!"),
            "blocked": bool(block) or handler == "none",
            "size_k": num(size), "paths": [p for p in paths.split("\n") if p],
        })
    return st


def run_self(*args):
    return ["bash", SELF] + list(args) + OPTS


STATE = load_state()
with open(os.path.join(UI_DIR, "index.html"), "rb") as fh:
    PAGE = fh.read()


class Handler(BaseHTTPRequestHandler):
    server_version = "macsweep"
    sys_version = ""

    def log_message(self, *a):
        pass

    def send(self, code, body, ctype="application/json"):
        if not isinstance(body, bytes):
            body = json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        if ctype.startswith("text/html"):
            self.send_header("Content-Security-Policy",
                             "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; "
                             "connect-src 'self'; img-src data:; frame-ancestors 'none'")
        self.end_headers()
        self.wfile.write(body)

    def host_ok(self):  # blocks DNS-rebinding: only our own address is accepted
        return self.headers.get("Host") in ("127.0.0.1:%d" % PORT, "localhost:%d" % PORT)

    def authed(self):
        return self.host_ok() and secrets.compare_digest(self.headers.get("X-Macsweep-Token", ""), TOKEN)

    def do_GET(self):
        path = self.path.split("?")[0]
        if not self.host_ok():
            return self.send(403, {"error": "forbidden"})
        if path in ("/", "/index.html"):
            return self.send(200, PAGE, "text/html; charset=utf-8")
        if path == "/api/state":
            if not self.authed():
                return self.send(403, {"error": "forbidden"})
            return self.send(200, STATE)
        self.send(404, {"error": "not found"})

    def do_POST(self):
        global STATE
        path = self.path.split("?")[0]
        if not self.authed():
            return self.send(403, {"error": "forbidden"})
        try:
            n = int(self.headers.get("Content-Length") or 0)
            body = json.loads(self.rfile.read(n) or b"{}") if n else {}
        except ValueError:
            return self.send(400, {"error": "bad request"})

        if path == "/api/quit":
            self.send(200, {"ok": True})
            threading.Thread(target=self.server.shutdown, daemon=True).start()
            return

        if not BUSY.acquire(blocking=False):
            return self.send(409, {"error": "busy"})
        try:
            if path == "/api/scan":
                subprocess.run(run_self("__scan", UI_DIR), stdin=subprocess.DEVNULL,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                STATE = load_state()
                return self.send(200, STATE)
            if path == "/api/delete":
                return self.delete(body)
            self.send(404, {"error": "not found"})
        finally:
            BUSY.release()

    def delete(self, body):
        if body.get("confirm") != CONFIRM.get(STATE["lang"], "DELETE"):
            return self.send(400, {"error": "confirmation word missing"})
        items = STATE["items"]
        ids = []
        for i in body.get("ids") or []:
            if isinstance(i, int) and 0 <= i < len(items) and not items[i]["blocked"] and i not in ids:
                ids.append(i)
        if not ids:
            return self.send(400, {"error": "nothing selected"})
        # stream progress as NDJSON; HTTP/1.0 closes the connection at the end
        self.send_response(200)
        self.send_header("Content-Type", "application/x-ndjson")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        p = subprocess.Popen(run_self("__exec", UI_DIR, ",".join(map(str, ids))), stdin=subprocess.DEVNULL,
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, universal_newlines=True)
        alive = True
        for line in p.stdout:  # keep reading even if the tab went away: deletion runs to the end
            f = line.rstrip("\n").split("\t")
            if f[0] == "S":
                ev = {"event": "start", "id": num(f[1])}
            elif f[0] == "D":
                ev = {"event": "done", "id": num(f[1])}
            elif f[0] == "F" and len(f) > 2:
                ev = {"event": "finished", "freed_k": num(f[1]), "free_k": num(f[2]), "dry_run": STATE["dry_run"]}
            else:
                continue
            if alive:
                try:
                    self.wfile.write((json.dumps(ev) + "\n").encode())
                    self.wfile.flush()
                except OSError:
                    alive = False
        p.wait()


server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
server.daemon_threads = True
PORT = server.server_address[1]
url = "http://127.0.0.1:%d/#%s" % (PORT, TOKEN)
m = MSG.get(STATE["lang"], MSG["en"])
print("\n  %s\n  \033[1m%s\033[0m\n\n  %s\n" % (m[0], url, m[1]) if sys.stdout.isatty() else "%s %s" % (m[0], url), flush=True)
if not os.environ.get("MACSWEEP_NO_OPEN") and shutil.which("open"):
    subprocess.Popen(["open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
try:
    server.serve_forever()
except KeyboardInterrupt:
    pass
print("  macsweep ui %s" % m[2])
PY
}
