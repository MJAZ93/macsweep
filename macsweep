section.tier { margin-top: 28px; scroll-margin-top: 76px; }
.tier-head { display: flex; align-items: center; gap: 12px; padding: 0 4px 10px; flex-wrap: wrap; }
.tier-head .total { font-weight: 700; }
.tier-head .desc { color: var(--muted); }
.tier-head .btn { margin-left: auto; height: 28px; font-size: 13px; }
.list { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; box-shadow: var(--shadow); }
.empty { padding: 18px; color: var(--faint); }

.row { border-top: 1px solid var(--line); position: relative; display: flow-root; }
.row:first-child { border-top: 0; }
.row.on { background: var(--hover); }
.row label { display: grid; grid-template-columns: 22px 84px 1fr; gap: 14px; align-items: start; padding: 13px 18px 13px 16px; cursor: pointer; }
.row.blocked label { cursor: default; }
.row:not(.blocked):hover { background: var(--hover); }
.check { appearance: none; -webkit-appearance: none; width: 20px; height: 20px; margin: 1px 0 0; border-radius: 6px; border: 1.5px solid var(--faint);
  display: grid; place-items: center; cursor: inherit; transition: background .12s, border-color .12s; }
.check::after { content: ""; width: 10px; height: 6px; border: 2px solid var(--accent-ink); border-top: 0; border-right: 0; transform: rotate(-45deg) translate(1px,-1px); opacity: 0; }
.check:checked { background: var(--accent); border-color: var(--accent); }
.check:checked::after { opacity: 1; }
.check:disabled { opacity: .35; }
.size { font-weight: 700; text-align: right; white-space: nowrap; }
.size.zero { color: var(--faint); font-weight: 500; }
.label { font-weight: 600; word-break: break-word; }
.note { color: var(--muted); font-size: 13px; margin-top: 2px; }
.warn { color: var(--warn); font-size: 13px; margin-top: 4px; font-weight: 500; }
.sizebar { position: absolute; left: 0; bottom: 0; height: 2px; background: var(--accent); opacity: .35; }
.paths { margin: -6px 18px 12px 152px; font-size: 12px; color: var(--muted); }
.paths summary { cursor: pointer; color: var(--faint); list-style: none; display: inline-flex; align-items: center; gap: 4px; }
.paths summary::-webkit-details-marker { display: none; }
.paths summary::before { content: "›"; display: inline-block; transition: transform .15s; font-size: 14px; }
.paths[open] summary::before { transform: rotate(90deg); }
.paths code { display: block; font: 11.5px/1.5 ui-monospace, "SF Mono", Menlo, monospace; word-break: break-all; color: var(--muted); padding-left: 12px; }

.footer { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; background: var(--glass); backdrop-filter: saturate(180%) blur(16px);
  -webkit-backdrop-filter: saturate(180%) blur(16px); border-top: 1px solid var(--line); transform: translateY(100%); visibility: hidden;
  transition: transform .2s ease, visibility .2s; }
.footer.show { transform: none; visibility: visible; }
.footer .wrap { display: flex; align-items: center; gap: 14px; height: 68px; }
.footer .sum { font-weight: 600; }
.footer .sum b { font-size: 18px; }

dialog { border: 0; border-radius: 16px; padding: 0; width: min(560px, calc(100vw - 32px)); background: var(--panel); color: var(--ink);
  box-shadow: 0 24px 80px rgba(0,0,0,.35); }
dialog::backdrop { background: rgba(0,0,0,.4); backdrop-filter: blur(2px); }
.dlg { padding: 22px 24px; }
.dlg h2 { margin: 0 0 4px; font-size: 19px; letter-spacing: -.01em; }
.dlg .sub { color: var(--muted); margin: 0 0 16px; }
.dlg-list { max-height: 42vh; overflow: auto; border: 1px solid var(--line); border-radius: 10px; }
.dlg-item { display: grid; grid-template-columns: 22px 1fr auto; gap: 10px; align-items: center; padding: 9px 12px; border-top: 1px solid var(--line); }
.dlg-item:first-child { border-top: 0; }
.dlg-item .size { font-size: 13px; }
.dlg-item .label { font-weight: 500; font-size: 13.5px; }
.dot { width: 8px; height: 8px; border-radius: 50%; margin: auto; }
.dot.SAFE { background: var(--safe); } .dot.REBUILD { background: var(--rebuild); } .dot.REVIEW { background: var(--review); }
.dlg-total { display: flex; justify-content: space-between; padding: 12px 2px 0; font-weight: 700; }
.dlg-confirm { margin-top: 18px; }
.dlg-confirm label { display: block; color: var(--muted); margin-bottom: 6px; }
.dlg-confirm input { width: 100%; height: 40px; border-radius: 10px; border: 1.5px solid var(--line); background: var(--bg); color: var(--ink);
  padding: 0 12px; font: 600 15px ui-monospace, "SF Mono", Menlo, monospace; letter-spacing: .08em; }
.dlg-confirm input:focus { outline: none; border-color: var(--danger); }
.dlg-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; }
.st { width: 18px; height: 18px; display: grid; place-items: center; color: var(--faint); }
.st.done { color: var(--safe); }
.st svg { width: 16px; height: 16px; }
.spin { width: 15px; height: 15px; border-radius: 50%; border: 2px solid var(--line); border-top-color: var(--accent); animation: spin .7s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.result { text-align: center; padding: 6px 0 4px; }
.result .big { font-size: 34px; font-weight: 800; letter-spacing: -.02em; color: var(--safe); }
.result .log { color: var(--faint); font-size: 12px; margin-top: 10px; word-break: break-all; }

.veil { position: fixed; inset: 0; z-index: 20; display: none; place-items: center; background: var(--glass); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); }
.veil.show { display: grid; }
.veil .box { display: flex; flex-direction: column; align-items: center; gap: 14px; color: var(--muted); font-weight: 500; }
.veil .spin { width: 28px; height: 28px; border-width: 3px; }
.toast { position: fixed; left: 50%; bottom: 88px; transform: translateX(-50%); background: var(--ink); color: var(--bg); padding: 10px 16px; border-radius: 10px;
  font-weight: 500; z-index: 30; display: none; max-width: calc(100vw - 32px); }
.toast.show { display: block; }

@media (max-width: 680px) {
  .cards { grid-template-columns: 1fr; }
  .row label { grid-template-columns: 22px 62px 1fr; gap: 10px; padding-right: 14px; }
  .paths { margin-left: 124px; }
  .brand small { display: none; }
}
</style>
</head>
<body>
<header>
  <div class="wrap bar-top">
    <div class="brand">
      <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="var(--accent)"/><path d="M9 22l9-12m-4 14h10" stroke="var(--accent-ink)" stroke-width="3" stroke-linecap="round" fill="none"/></svg>
      <span>macsweep</span> <small id="tagline"></small>
    </div>
    <div class="spacer"></div>
    <button class="btn" id="rescan"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M13.5 8a5.5 5.5 0 1 1-1.6-3.9M13.5 2.5v3h-3"/></svg><span></span></button>
    <button class="btn ghost" id="quit"></button>
  </div>
</header>

<main class="wrap">
  <div class="disk">
    <div class="disk-head">
      <span class="disk-free num" id="free"></span>
      <span class="disk-sub num" id="freeSub"></span>
      <span class="disk-after num" id="after"></span>
    </div>
    <div class="meter" id="meter"><span class="used"></span><span class="sel"></span></div>
    <div class="meta" id="meta"></div>
  </div>
  <div class="banner" id="dry" hidden></div>
  <div class="cards" id="cards"></div>
  <div id="tiers"></div>
</main>

<div class="footer" id="footer">
  <div class="wrap">
    <div class="sum"><b class="num" id="selSize"></b> <span id="selCount"></span></div>
    <div class="spacer"></div>
    <button class="btn ghost" id="clear"></button>
    <button class="btn danger" id="review"></button>
  </div>
</div>

<dialog id="confirm">
  <form class="dlg" method="dialog" id="confirmForm">
    <h2 id="cTitle"></h2>
    <p class="sub" id="cSub"></p>
    <div class="dlg-list" id="cList"></div>
    <div class="dlg-total"><span id="cTotalL"></span><span class="num" id="cTotal"></span></div>
    <div class="dlg-confirm">
      <label for="cWord" id="cHint"></label>
      <input id="cWord" autocomplete="off" autocapitalize="characters" spellcheck="false">
    </div>
    <div class="dlg-actions">
      <button class="btn" type="button" id="cCancel"></button>
      <button class="btn danger" value="ok" id="cOk" disabled></button>
    </div>
  </form>
</dialog>

<dialog id="progress">
  <div class="dlg">
    <h2 id="pTitle"></h2>
    <p class="sub" id="pSub"></p>
    <div class="dlg-list" id="pList"></div>
    <div class="result" id="pResult" hidden></div>
    <div class="dlg-actions"><button class="btn primary" id="pClose" disabled></button></div>
  </div>
</dialog>

<div class="veil" id="veil"><div class="box"><div class="spin"></div><span id="veilText"></span></div></div>
<div class="toast" id="toast"></div>

<script>
"use strict";
const TOKEN = location.hash.slice(1);
const TIERS = ["SAFE", "REBUILD", "REVIEW"];
const I18N = {
  en: {
    tagline: "disk cleanup for developer Macs", free: "free", of: "of", used: "used", rescan: "Rescan", quit: "Quit",
    SAFE: "SAFE", REBUILD: "REBUILD", REVIEW: "REVIEW",
    SAFE_d: "Caches that tools recreate on their own", REBUILD_d: "Deletable, but you will reinstall or rebuild",
    REVIEW_d: "May hold your data: decide one by one",
    items: n => n === 1 ? "1 item" : n + " items", selectSafe: "Select all safe", inuse: "In use: close",
    nothing: n => "Nothing found above " + n + " MB", selected: n => n === 1 ? "1 item selected" : n + " items selected",
    clear: "Deselect all", review: "Review & delete…", after: v => v + " free after cleanup",
    projects: "Projects", minmb: n => "Hiding items under " + n + " MB", log: "Log at",
    dry: "Dry run: you can go through the whole flow, nothing will be deleted.",
    cTitle: n => n === 1 ? "Delete 1 item?" : "Delete " + n + " items?",
    cSub: "This cannot be undone. Items marked REVIEW may hold your data.", total: "Total",
    cHint: w => "Type " + w + " to confirm", word: "DELETE", cancel: "Cancel", del: "Delete",
    pTitle: "Deleting", pTitleDry: "Dry run", pSub: "Apps that need a password will ask for it in a macOS dialog.",
    done: "Done", freed: "freed", dryDone: "Dry run finished. Nothing was deleted.", close: "Close",
    measuring: "Measuring…", paths: n => n === 1 ? "1 path" : n + " paths", noSize: "n/a",
    quitMsg: "macsweep has stopped. You can close this tab.", err: "Something went wrong: ", busy: "Busy with another task, try again in a moment.",
    noToken: "Open the link printed in the terminal (it carries the access token).",
  },
  pt: {
    tagline: "limpeza de disco para Macs de developers", free: "livre", of: "de", used: "usado", rescan: "Analisar de novo", quit: "Sair",
    SAFE: "SEGURO", REBUILD: "REGENERÁVEL", REVIEW: "VERIFICAR",
    SAFE_d: "Caches que as ferramentas recriam sozinhas", REBUILD_d: "Apaga-se, mas exige reinstalar ou recompilar",
    REVIEW_d: "Pode ter dados teus: decide caso a caso",
    items: n => n === 1 ? "1 item" : n + " itens", selectSafe: "Seleccionar todos os seguros", inuse: "Em uso: fecha",
    nothing: n => "Nada encontrado acima de " + n + " MB", selected: n => n === 1 ? "1 item seleccionado" : n + " itens seleccionados",
    clear: "Desmarcar tudo", review: "Rever e apagar…", after: v => v + " livres depois da limpeza",
    projects: "Projectos", minmb: n => "A esconder itens abaixo de " + n + " MB", log: "Registo em",
    dry: "Modo simulação: podes percorrer tudo, nada será apagado.",
    cTitle: n => n === 1 ? "Apagar 1 item?" : "Apagar " + n + " itens?",
    cSub: "Não dá para desfazer. Os itens VERIFICAR podem ter dados teus.", total: "Total",
    cHint: w => "Escreve " + w + " para confirmar", word: "APAGAR", cancel: "Cancelar", del: "Apagar",
    pTitle: "A apagar", pTitleDry: "Simulação", pSub: "O que precisar de password pede-a numa janela do macOS.",
    done: "Concluído", freed: "libertados", dryDone: "Simulação concluída. Nada foi apagado.", close: "Fechar",
    measuring: "A medir…", paths: n => n === 1 ? "1 caminho" : n + " caminhos", noSize: "n/d",
    quitMsg: "O macsweep terminou. Podes fechar este separador.", err: "Algo correu mal: ", busy: "Ocupado com outra tarefa, tenta daqui a pouco.",
    noToken: "Abre o link que aparece no terminal (leva o código de acesso).",
  },
};
let L = I18N.en, S = null;
const sel = new Set();
const $ = id => document.getElementById(id);

function h(tag, attrs, ...kids) {
  const el = document.createElement(tag);
  for (const [k, v] of Object.entries(attrs || {})) {
    if (v == null || v === false) continue;
    if (k === "class") el.className = v;
    else if (k.startsWith("on")) el.addEventListener(k.slice(2), v);
    else if (k in el && typeof v !== "string") el[k] = v;
    else el.setAttribute(k, v === true ? "" : v);
  }
  for (const c of kids.flat()) if (c != null && c !== false) el.append(c.nodeType ? c : document.createTextNode(String(c)));
  return el;
}
function human(k) {
  if (k >= 1048576) return (k / 1048576).toFixed(1) + " GB";
  if (k >= 1024) return Math.round(k / 1024) + " MB";
  return Math.round(k) + " KB";
}
function toast(msg, ms) {
  const t = $("toast"); t.textContent = msg; t.classList.add("show");
  clearTimeout(toast.t); toast.t = setTimeout(() => t.classList.remove("show"), ms || 4000);
}
async function api(path, body) {
  const r = await fetch(path, {
    method: body === undefined ? "GET" : "POST",
    headers: { "X-Macsweep-Token": TOKEN, "Content-Type": "application/json" },
    body: body === undefined ? undefined : JSON.stringify(body),
  });
  if (r.status === 409) throw new Error(L.busy);
  if (!r.ok) { const e = await r.json().catch(() => ({})); throw new Error(e.error || "HTTP " + r.status); }
  return r;
}
const byId = id => S.items[id];
const selectable = it => !it.blocked;
const selTotal = () => [...sel].reduce((s, id) => s + byId(id).size_k, 0);

function staticText() {
  document.documentElement.lang = S.lang;
  $("tagline").textContent = "v" + S.version + " · " + L.tagline;
  $("rescan").querySelector("span").textContent = L.rescan;
  $("quit").textContent = L.quit;
  $("clear").textContent = L.clear;
  $("review").textContent = L.review;
  $("dry").hidden = !S.dry_run; $("dry").textContent = L.dry;
  $("veilText").textContent = L.measuring;
}

function renderDisk() {
  const { total_k, free_k } = S.disk, used = total_k - free_k, picked = selTotal();
  const pct = total_k ? used * 100 / total_k : 0;
  $("free").textContent = human(free_k) + " " + L.free;
  $("freeSub").textContent = L.of + " " + human(total_k) + " · " + Math.round(pct) + "% " + L.used;
  $("after").textContent = picked ? L.after(human(free_k + picked)) : "";
  const [u, s] = $("meter").children;
  u.className = "used" + (pct > 90 ? " hot" : pct > 75 ? " warm" : "");
  u.style.width = (total_k ? Math.max(0, used - picked) * 100 / total_k : 0) + "%";
  s.style.width = (total_k ? Math.min(picked, used) * 100 / total_k : 0) + "%";
  const meta = $("meta"); meta.replaceChildren();
  if (S.projects) meta.append(h("span", null, L.projects + ": " + S.projects));
  meta.append(h("span", null, L.minmb(S.min_mb)));
}

function renderCards() {
  $("cards").replaceChildren(...TIERS.map(t => {
    const its = S.items.filter(i => i.tier === t);
    return h("button", { class: "card", onclick: () => document.getElementById("tier-" + t).scrollIntoView({ behavior: "smooth" }) },
      h("span", { class: "badge t-" + t }, L[t]),
      h("span", { class: "total num" }, human(its.reduce((s, i) => s + i.size_k, 0))),
      h("span", { class: "desc" }, L.items(its.length) + " · " + L[t + "_d"]));
  }));
}

function renderTiers() {
  const max = Math.max(1, ...S.items.map(i => i.size_k));
  $("tiers").replaceChildren(...TIERS.map(t => {
    const its = S.items.filter(i => i.tier === t).sort((a, b) => b.size_k - a.size_k);
    const head = h("div", { class: "tier-head" },
      h("span", { class: "badge t-" + t }, L[t]),
      h("span", { class: "total num" }, human(its.reduce((s, i) => s + i.size_k, 0))),
      h("span", { class: "desc" }, L[t + "_d"]));
    if (t === "SAFE" && its.some(selectable))
      head.append(h("button", { class: "btn", onclick: () => { its.filter(selectable).forEach(i => sel.add(i.id)); update(); } }, L.selectSafe));
    const list = h("div", { class: "list" });
    if (!its.length) list.append(h("div", { class: "empty" }, L.nothing(S.min_mb)));
    for (const it of its) {
      const row = h("div", { class: "row" + (it.blocked ? " blocked" : ""), "data-id": it.id },
        h("label", null,
          h("input", { type: "checkbox", class: "check", disabled: it.blocked, "aria-label": it.label,
            onchange: e => { e.target.checked ? sel.add(it.id) : sel.delete(it.id); update(); } }),
          h("span", { class: "size num" + (it.size_k ? "" : " zero") }, it.size_k ? human(it.size_k) : L.noSize),
          h("span", null,
            h("div", { class: "label" }, it.label),
            it.note && h("div", { class: "note" }, it.note),
            it.block && h("div", { class: "warn" }, "⚠ " + (it.block_msg ? it.block : L.inuse + " " + it.block)))),
        it.paths.length ? h("details", { class: "paths" }, h("summary", null, L.paths(it.paths.length)),
          it.paths.map(p => h("code", null, p))) : null,
        h("span", { class: "sizebar", style: "width:" + (it.size_k * 100 / max).toFixed(2) + "%" }));
      list.append(row);
    }
    return h("section", { class: "tier", id: "tier-" + t }, head, list);
  }));
}

function update() {
  for (const row of document.querySelectorAll(".row")) {
    const on = sel.has(+row.dataset.id);
    row.classList.toggle("on", on);
    row.querySelector("input").checked = on;
  }
  const n = sel.size;
  $("selSize").textContent = human(selTotal());
  $("selCount").textContent = "· " + L.selected(n);
  $("footer").classList.toggle("show", n > 0);
  renderDisk();
}

function render() {
  L = I18N[S.lang] || I18N.en;
  for (const id of [...sel]) if (!S.items[id] || S.items[id].blocked) sel.delete(id);
  staticText(); renderCards(); renderTiers(); update();
}

function sortedSel() { return [...sel].map(byId).sort((a, b) => TIERS.indexOf(a.tier) - TIERS.indexOf(b.tier) || b.size_k - a.size_k); }
function itemLine(it, lead) {
  return h("div", { class: "dlg-item", "data-id": it.id }, lead, h("span", { class: "label" }, it.label),
    h("span", { class: "size num" }, it.size_k ? human(it.size_k) : ""));
}

function openConfirm() {
  if (!sel.size) return;
  const its = sortedSel();
  $("cTitle").textContent = L.cTitle(its.length);
  $("cSub").textContent = L.cSub;
  $("cList").replaceChildren(...its.map(it => itemLine(it, h("span", { class: "dot " + it.tier, title: L[it.tier] }))));
  $("cTotalL").textContent = L.total; $("cTotal").textContent = human(selTotal());
  $("cHint").textContent = L.cHint(L.word);
  $("cCancel").textContent = L.cancel; $("cOk").textContent = L.del;
  $("confirm").returnValue = ""; $("cWord").value = ""; $("cWord").placeholder = L.word; $("cOk").disabled = true;
  $("confirm").showModal(); $("cWord").focus();
}
$("cCancel").addEventListener("click", () => $("confirm").close("cancel"));
$("cWord").addEventListener("input", e => { $("cOk").disabled = e.target.value.trim() !== L.word; });
$("confirm").addEventListener("close", () => { if ($("confirm").returnValue === "ok" && $("cWord").value.trim() === L.word) runDelete(); });

const ICON_OK = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5l3 3 6-7"/></svg>';
async function runDelete() {
  const its = sortedSel(), ids = its.map(i => i.id), st = {};
  $("pTitle").textContent = S.dry_run ? L.pTitleDry : L.pTitle;
  $("pSub").textContent = L.pSub; $("pSub").hidden = false;
  $("pList").hidden = false; $("pResult").hidden = true;
  $("pList").replaceChildren(...its.map(it => { const s = h("span", { class: "st" }, "○"); st[it.id] = s; return itemLine(it, s); }));
  $("pClose").textContent = L.close; $("pClose").disabled = true;
  $("progress").showModal();
  let fin = null;
  try {
    const r = await api("/api/delete", { ids, confirm: L.word });
    const reader = r.body.getReader(), dec = new TextDecoder();
    let buf = "";
    for (;;) {
      const { value, done } = await reader.read();
      if (done) break;
      buf += dec.decode(value, { stream: true });
      let nl;
      while ((nl = buf.indexOf("\n")) >= 0) {
        const ev = JSON.parse(buf.slice(0, nl)); buf = buf.slice(nl + 1);
        const s = st[ev.id];
        if (ev.event === "start" && s) { s.replaceChildren(h("span", { class: "spin" })); s.parentElement.scrollIntoView({ block: "nearest" }); }
        if (ev.event === "done" && s) { s.className = "st done"; s.innerHTML = ICON_OK; }
        if (ev.event === "finished") fin = ev;
      }
    }
    if (!fin) throw new Error("interrupted");
    sel.clear();
    S.disk.free_k = fin.free_k;
    const res = $("pResult"); res.hidden = false; $("pSub").hidden = true; $("pList").hidden = true;
    res.replaceChildren(fin.dry_run
      ? h("div", null, L.dryDone)
      : h("div", null, h("div", { class: "big num" }, human(Math.max(0, fin.freed_k)) + " " + L.freed),
          h("div", { class: "disk-sub num" }, human(fin.free_k) + " " + L.free + " " + L.of + " " + human(S.disk.total_k)),
          h("div", { class: "log" }, L.log + " " + S.log)));
    $("pTitle").textContent = L.done;
  } catch (e) {
    toast(L.err + e.message, 7000);
  }
  $("pClose").disabled = false; $("pClose").focus();
}
