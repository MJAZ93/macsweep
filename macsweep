      used)      echo "used" ;;
      safe)      echo "SAFE" ;;
      rebuild)   echo "REBUILD" ;;
      review)    echo "REVIEW" ;;
      safe_d)    echo "caches that tools recreate on their own" ;;
      rebuild_d) echo "deletable, but you will reinstall or rebuild" ;;
      review_d)  echo "may hold your data: decide one by one" ;;
      total)     echo "Total" ;;
      inuse)     echo "in use, close" ;;
      nothing)   echo "Nothing found above" ;;
      q_delete)  echo "Delete?" ;;
      keys)      echo "[y]es  [n]o  [a]ll safe  [r]est no  [q]uit" ;;
      selected)  echo "Selected" ;;
      none_sel)  echo "Nothing selected. Nothing was deleted." ;;
      confirm)   echo "Type DELETE to confirm (or Enter to cancel):" ;;
