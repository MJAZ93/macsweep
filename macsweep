#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────────────────────
#  macsweep — interactive disk cleaner for developer Macs
#
#  Finds the caches, build artifacts, simulators, emulators and worktrees that
#  quietly eat your disk, tells you how risky each one is, and asks before it
#  deletes anything.
#
#  Usage:   macsweep              scan only (never deletes)
#           macsweep clean        interactive: asks yes/no per item
#           macsweep clean --yes  auto-select every SAFE item (still confirms)
#           macsweep --help
#
#  Works on bash 3.2 (the one that ships with macOS). No dependencies.
#  https://github.com/MJAZ93/macsweep
# ──────────────────────────────────────────────────────────────────────────────
set -u
VERSION="1.0.0"

# ── options ───────────────────────────────────────────────────────────────────
MODE="scan"
PROJECTS_DIR=""
INACTIVE_DAYS=30
AUTO_YES=0
DRY_RUN=0
FAST=0
LANG_UI=""
MIN_MB=50               # hide items smaller than this
LOG_FILE="$HOME/Library/Logs/macsweep.log"

while [ $# -gt 0 ]; do
  case "$1" in
    scan)            MODE="scan" ;;
    clean)           MODE="clean" ;;
    --projects)      PROJECTS_DIR="$2"; shift ;;
    --days)          INACTIVE_DAYS="$2"; shift ;;
    --yes|-y)        AUTO_YES=1 ;;
    --dry-run)       DRY_RUN=1 ;;
    --fast)          FAST=1 ;;
    --lang)          LANG_UI="$2"; shift ;;
    --min-mb)        MIN_MB="$2"; shift ;;
    --no-color)      NO_COLOR=1 ;;
    -v|--version)    echo "macsweep $VERSION"; exit 0 ;;
    -h|--help)       MODE="help" ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

if [ "$(id -u)" = "0" ]; then echo "Do not run macsweep as root." >&2; exit 1; fi

# ── language ──────────────────────────────────────────────────────────────────
if [ -z "$LANG_UI" ]; then
  case "${LC_ALL:-${LANG:-en}}" in pt*) LANG_UI=pt ;; *) LANG_UI=en ;; esac
fi
t() {
